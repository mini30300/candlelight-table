## จำนวนจุดในวงที่ r ของการหาที่ว่างแบบกว้าง (อย่างน้อยสิบสี่) เท่ากับสูตร Math.round ของหน้าเก่าทุก r ไม่เกินสี่ร้อย
static func fs_ring_n(r: int) -> int:
	return maxi(14, Fx.js_round(r * FS_RING_K, 1000000))
