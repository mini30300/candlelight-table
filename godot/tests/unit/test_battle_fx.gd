extends "res://tests/testing.gd"
## Battle animations and weapon effects (scenes/battle/battle_fx_rules.gd + battle_fx.gd), headless:
## - for every datasheet the attack kind, the weapon effect kind (fxOf with the page's name guesses) and machOf equal
##   the old page's own startAttack, recorded by tools/record_battle_fx.js (tests/unit/fixtures/battle_fx/page_fx.json);
## - attack plans: shot timings (GUN_T / KIND_T8), blow / stomp counts, clips that exist in humanoid.res when it is
##   built, death and flinch clips;
## - BattleFx never writes to the rules: a bot game fed to it step by step keeps the same digest as a game without it.

const FIXTURE := "res://tests/unit/fixtures/battle_fx/page_fx.json"
const LIB := "res://assets/anim/humanoid.res"
const TABLE_SCENE := "res://scenes/battle_table.tscn"


func _fixture() -> Dictionary:
	var f: Variant = JSON.parse_string(FileAccess.get_file_as_string(FIXTURE))
	return f if f is Dictionary else {}


func test_attack_choice_matches_the_page() -> void:
	var page := _fixture()
	assert_eq(page.size(), GameData.types().size(), "the fixture covers every datasheet")
	var rng := RandomNumberGenerator.new()
	var bad := []
	for k: String in page:
		var want: Array = (page[k] as Array).duplicate()
		want[4] = int(want[4])
		var r := BattleFxRules.plan(k, false, [true, true], rng)
		var m := BattleFxRules.plan(k, true, [true, true], rng)
		var got := [str(r["kind"]), BattleFxRules.fx_of(k, false), str(m["kind"]), BattleFxRules.fx_of(k, true),
			1 if BattleFxRules.mach_of(k) else 0]
		# หน้าเดิมเช็กข้อเท้าของโครงก่อนกระทืบ: ตัวที่ไม่มีขาก็ตีแบบเดิม (ภาพเท่านั้น)
		if str(want[2]) != "stomp" and got[2] == "stomp":
			got[2] = want[2]
		if got != want:
			bad.append("%s: page %s, port %s" % [k, str(want), str(got)])
	assert_eq(bad, [], "attack kind / fxOf / machOf of all %d datasheets equal the page's" % page.size())


func test_shot_timings() -> void:
	var rng := RandomNumberGenerator.new()
	var p := BattleFxRules.plan("sniper", false, [true, false], rng)
	assert_eq(str(p["kind"]), "fire", "a sniper fires")
	assert_within(float(p["shots"][0]["t"]), 0.7, 1e-6, "the sniper settles 0.7 s on the scope (GUN_T)")
	assert_within(float(p["shots"][1]["t"]), 1.0, 1e-6, "then 0.3 s between shots")
	assert_eq(str(p["clips"][0]["c"]), "fire_sniper", "with the sniper clip")
	var inf := BattleFxRules.plan("infantry", false, [true, true, true, true, true], rng)
	assert_within(float(inf["shots"][1]["t"]) - float(inf["shots"][0]["t"]), 0.11, 1e-6, "a long burst: 0.11 s apart")
	var hits := []
	for i in 20:
		hits.append(true)
	assert_eq((BattleFxRules.plan("infantry", false, hits, rng)["shots"] as Array).size(), 8, "at most 8 tracers per model")
	var mel := BattleFxRules.plan("kblade", true, [true, false, true, true], rng)
	assert_eq((mel["shots"] as Array).size(), 3, "at most 3 blows")
	assert_eq((mel["clips"] as Array).size(), 3, "one swing clip per blow")
	assert_true(str(mel["clips"][0]["c"]).begins_with("swing_"), "a sword swings", mel["clips"])
	assert_eq(bool(mel["shots"][1]["hit"]), false, "the second blow misses like its dice")


func test_clips_exist() -> void:
	if not ResourceLoader.exists(LIB):
		assert_true(true, "humanoid.res is not built here (generated by tools/kits.sh): clip names not checked")
		return
	var lib := load(LIB) as AnimationLibrary
	var rng := RandomNumberGenerator.new()
	var missing := {}
	for t in GameData.types():
		var k := str(t["k"])
		for melee in [false, true]:
			for c: Dictionary in BattleFxRules.plan(k, melee, [true, true, true], rng)["clips"]:
				if not lib.has_animation(StringName(str(c["c"]))):
					missing[str(c["c"])] = k
	for v: String in BattleFxRules.DIE_CLIP:
		var c := str(BattleFxRules.DIE_CLIP[v])
		if c != "" and not lib.has_animation(StringName(c)):
			missing[c] = v
	for side in ["front", "back", "left", "right"]:
		for heavy in [false, true]:
			var c2 := BattleFxRules.flinch_clip(side, heavy)
			if not lib.has_animation(StringName(c2)):
				missing[c2] = side
	assert_true(lib.has_animation(&"brace"), "the shield clip exists")
	assert_eq(missing, {}, "every clip the battle plays is in humanoid.res")


func test_deaths() -> void:
	assert_eq(BattleFxRules.death_of("mech", "", false, 1, 3.0, 0.5), "boom", "a machine explodes")
	assert_eq(BattleFxRules.death_of("infantry", "cannon", false, 1, 1.6, 0.9), "blown", "a cannon blows a soldier away")
	assert_eq(BattleFxRules.death_of("infantry", "sniper", false, 1, 1.6, 0.9), "drop", "a sniper drops him")
	assert_eq(BattleFxRules.death_of("infantry", "", false, 1, 4.0, 0.1), "topple", "a tall one topples")
	assert_eq(BattleFxRules.death_of("infantry", "", true, 1, 1.6, 0.1), "fwd", "melee: falls forward on a low roll")
	assert_eq(BattleFxRules.colour("rgba(255,128,0,0.5)"), Color(1.0, 128.0 / 255.0, 0.0, 0.5), "rgba colours")
	assert_eq(BattleFxRules.colour("#FF0000").r, 1.0, "hex colours")


func test_fx_never_touches_the_rules() -> void:
	var c := _choices()
	var a := MatchRunner.new(SeatPlan.build(c))
	var b := MatchRunner.new(SeatPlan.build(c))
	a.start()
	b.start()
	var tv := (load(TABLE_SCENE) as PackedScene).instantiate()
	tv.set("auto_build", false)
	tv.set("figure_style", "egg")
	(Engine.get_main_loop() as SceneTree).root.add_child(tv)
	tv.call("build_battle", a.st)
	var fx := BattleFx.new()
	tv.add_child(fx)
	fx.allowed = true
	fx.enabled = true
	fx.begin(tv, a.st)
	fx.set_level("hi")
	var n := 0
	var peak := 0
	while not a.is_over() and n < 6000:
		var r := a.step()
		tv.call("sync_battle", a.st)
		fx.feed(r["events"], a.st)
		for i in 3:
			fx._process(0.2)
		peak = maxi(peak, int(fx.counts()["fallen"]))
		n += 1
	n = 0
	while not b.is_over() and n < 6000:
		b.step()
		n += 1
	assert_true(a.is_over() and b.is_over(), "both bot games end")
	assert_eq(a.replayed_digest(), b.replayed_digest(), "the same digest with and without the effects layer")
	assert_eq(a.digest(), b.digest(), "the same final state")
	assert_true(int(fx.stats["attacks"]) > 0 and int(fx.stats["shots"]) > 0, "attacks and shots were drawn", fx.stats)
	assert_true(int(fx.stats["deaths"]) > 0, "deaths were drawn", fx.stats)
	assert_true(peak > 0 and peak <= int(BattleFx.LV["hi"]["fallen"]), "fallen figures stay on the field, capped (peak %d)" % peak)
	for i in 60:
		fx._process(0.2)
	var cn := fx.counts()
	assert_eq([cn["actors"], cn["shots"], cn["beams"], cn["puffs"], cn["sparks"], cn["queued"], cn["processing"]],
		[0, 0, 0, 0, 0, 0, false], "everything frees itself and processing stops")
	fx.set_level("min")
	assert_eq(int(fx.counts()["fallen"]), 0, "min keeps no fallen figures")
	fx.clear()
	tv.call("end_battle")
	tv.get_parent().remove_child(tv)
	tv.free()


func _choices() -> Dictionary:
	var c := SeatPlan.defaults(31)
	c["size"] = "s"
	c["goal"] = "obj"
	c["rounds"] = 3
	c["budget"] = 300
	c["seats"] = [{"fac": "kn", "human": false}, {"fac": "or", "human": false}]
	return c
