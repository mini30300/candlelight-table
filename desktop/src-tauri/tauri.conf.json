{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Candlelight Table",
  "version": "1.0.0",
  "identifier": "dev.mini.candlelight.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Candlelight Table",
        "url": "https://candlelight-table.mini3030023450.workers.dev/app",
        "width": 1180,
        "height": 780,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "โต๊ะ D&D ที่มี Claude เป็นผู้คุมเกม",
    "longDescription": "เล่น Candlelight Table บนคอม เข้าบัญชีเดียวกับมือถือด้วยรหัสจับคู่ แล้วนั่งโต๊ะเดียวกัน",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
